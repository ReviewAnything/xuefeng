{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": false,
    "noImplicitAny": false,
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "jsx": "preserve",
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@shared/*": ["../shared/*"]
    }
  },
  "include": [
    "env.d.ts",
    "src/types/**/*.ts",
    "src/constants/**/*.ts",
    "src/stores/**/*.ts",
    "src/api/**/*.ts",
    "src/composables/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "unpackage", "**/*.vue", "**/*.test.mjs", "tests"]
}
