{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^wd-(.*)": "wot-design-uni/components/wd-$1/wd-$1.vue"
    }
  },
  "pages": [
    { "path": "pages/verdict/verdict", "style": { "navigationBarTitleText": "结论" } },
    { "path": "pages/diagnose/diagnose", "style": { "navigationBarTitleText": "自我诊断" } },
    { "path": "pages/graph/graph", "style": { "navigationBarTitleText": "图谱" } },
    { "path": "pages/verify/verify", "style": { "navigationBarTitleText": "观点×数据核验" } },
    { "path": "pages/recommend/recommend", "style": { "navigationBarTitleText": "院校推荐·冲稳保" } },
    { "path": "pages/plan/plan", "style": { "navigationBarTitleText": "志愿表草稿" } },
    { "path": "pages/majorGroup/majorGroup", "style": { "navigationBarTitleText": "院校专业组" } },
    { "path": "pages/about/about", "style": { "navigationBarTitleText": "关于" } },
    { "path": "pages/webview/webview", "style": { "navigationBarTitleText": "原始数据", "navigationBarTextStyle": "white", "navigationBarBackgroundColor": "#0f1115" } }
