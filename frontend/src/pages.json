  "globalStyle": {
    "navigationBarTextStyle": "white",
    "navigationBarTitleText": "志愿决策助手",
    "navigationBarBackgroundColor": "#0f1115",
    "backgroundColor": "#0f1115"
  },
  "tabBar": {
    "color": "#8a909c",
    "selectedColor": "#ffd24d",
    "backgroundColor": "#16191f",
    "borderStyle": "black",
    "list": [
      { "pagePath": "pages/verdict/verdict", "text": "结论" },
      { "pagePath": "pages/graph/graph", "text": "图谱" },
      { "pagePath": "pages/verify/verify", "text": "核验" },
      { "pagePath": "pages/about/about", "text": "关于" }
    ]
  }
}
