    "build:app": "uni build -p app",
    "test:engine": "node tests/engine.test.mjs",
    "test:template": "node tests/template.test.mjs",
    "test": "node tests/engine.test.mjs && node tests/template.test.mjs"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020620260917001",
    "@dcloudio/uni-app-plus": "3.0.0-5020620260917001",
