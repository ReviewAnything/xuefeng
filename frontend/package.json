{
  "name": "zhiyuan-app",
  "version": "2.1.0",
  "description": "志愿决策助手 · uni-app(Vue3) + wot-design-uni 跨端前端 + Python 后端（P2 观点×数据交叉核验 + 数据落库 + 管理端）",
  "type": "module",
  "scripts": {
    "dev:h5": "uni",
